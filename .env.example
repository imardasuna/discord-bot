# Discord Developer Portal → Bot → Token
DISCORD_TOKEN=

# Discord Developer Portal → General Information → Application ID
DISCORD_CLIENT_ID=

# Test sunucusunun ID'si (slash komutlarinin aninda gelmesi icin)
# Discord'da Ayarlar → Gelistirici Modu ac, sunucuya sag tik → ID'yi Kopyala
DISCORD_GUILD_ID=

# Komut oneki (sohbet icin)
PREFIX=!

# Spotify Developer Dashboard → Create app
# Redirect URI: http://127.0.0.1:8888/callback  (aynen ekle)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback
SPOTIFY_OAUTH_PORT=8888
